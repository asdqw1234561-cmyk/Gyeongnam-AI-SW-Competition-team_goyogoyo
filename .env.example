ANTHROPIC_API_KEY=sk-ant-...

# data.go.kr - 건강보험심사평가원 병원정보서비스 Open API 인증키
# 발급: https://www.data.go.kr/data/15001698/openapi.do -> 활용신청
HIRA_SERVICE_KEY=

# data.go.kr - 소상공인시장진흥공단 상가(상권)정보 API 인증키 (편의점 수집용)
# 발급: https://www.data.go.kr/data/15012005/openapi.do -> 활용신청
SBIZ_SERVICE_KEY=

# LLM 백엔드: ollama(기본) 또는 claude_cli (PC에 로그인된 Claude Code CLI 사용, API 키 불필요)
LLM_BACKEND=ollama
# claude_cli 사용 시 선택 항목: 모델(sonnet/haiku/opus), 제한 시간(초)
CLAUDE_CLI_MODEL=
CLAUDE_CLI_TIMEOUT=200

# 위치 Agent 방식 (pages/user.py)
#   claude_agent(기본): claude -p + MCP 서버, Claude가 도구를 직접 반복 호출. 실패 시 아래 계획형으로 전환
#   claude_cli: Claude가 계획 JSON만 작성 / ollama: LLM_BACKEND 로 계획 -> 둘 다 이후 결과 검토 루프(agent/agent_loop.py)
LOCATION_AGENT_BACKEND=claude_agent
LOCATION_AGENT_CLAUDE_MODEL=

# AI 호출 남용 방지 (0 = 제한 없음, 화면에서 호출될 때만 횟수를 셈)
LLM_MAX_CALLS_PER_SESSION=30
LLM_MAX_CALLS_PER_DAY=500
LLM_MAX_INPUT_CHARS=4000
